# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# Session signing secrets (generate long random strings for production)
SESSION_SECRET="change-me-user-session-secret"
ADMIN_SESSION_SECRET="change-me-admin-session-secret"

# Seed data (used by `npm run seed`)
SEED_ADMIN_ID="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="Customer123!"

# Google account that gets admin access when it signs in via the "Google로 관리자 로그인"
# button on /admin/login (matched against AdminUser.email — see prisma/seed.ts).
# This is the ONLY way into /admin now; there is no password login.
ADMIN_GOOGLE_EMAIL="you@example.com"

# Public origin of the deployed app — used to build OAuth redirect URIs and links in
# Discord bot embeds. Must match how users actually reach the site (scheme + host).
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3014"

# ── Discord: webhook notifications (legacy/simple option) ─────────────────────
# All of the settings below can ALSO be set from the admin panel at /admin/settings
# (DB value wins over env if both are set). These env vars are just the zero-config
# fallback so the app works out of the box.

# Optional: Discord webhook for new-order notifications (skipped silently if unset).
# Get one from: Discord server > Server Settings > Integrations > Webhooks > New Webhook.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# ── Discord: bot (slash commands) ──────────────────────────────────────────────
# Create an application + bot at https://discord.com/developers/applications
# 1. "New Application" -> note the Application ID (this is DISCORD_CLIENT_ID)
# 2. Bot tab -> "Reset Token" -> copy it (this is DISCORD_BOT_TOKEN) -- treat as a secret
# 3. OAuth2 > URL Generator -> scopes: "bot" + "applications.commands", permissions:
#    "Send Messages" -> open the generated URL to invite the bot to your server
# 4. Enable Developer Mode in Discord (User Settings > Advanced), then right-click your
#    server icon -> "Copy Server ID" for DISCORD_GUILD_ID (optional but makes slash
#    commands register instantly instead of waiting up to 1 hour for global rollout)
# 5. Right-click your own user / a role -> "Copy ID" for DISCORD_ADMIN_USER_IDS /
#    DISCORD_ADMIN_ROLE_IDS -- only these Discord users/roles can run the bot's
#    admin slash commands (/주문목록, /주문, /공지)
DISCORD_CLIENT_ID=""
# DISCORD_BOT_TOKEN=""
# DISCORD_GUILD_ID=""
# DISCORD_ADMIN_USER_IDS=""
# DISCORD_ADMIN_ROLE_IDS=""
# Channel ID the bot should post new-order notifications to, if using the bot
# (instead of a webhook) to deliver notifications. Right-click a channel -> Copy ID.
# DISCORD_NOTIFY_CHANNEL_ID=""

# ── Discord OAuth (customer login, third option alongside Google/GitHub) ───────
# Uses the SAME Discord application as the bot above (Discord shares one app ID
# between bot client and OAuth client). In the Developer Portal: OAuth2 > General
# to find the Client Secret, and OAuth2 > Redirects to register the callback URL:
# <NEXT_PUBLIC_APP_ORIGIN>/api/auth/discord/callback
# DISCORD_OAUTH_CLIENT_ID=""   # same value as DISCORD_CLIENT_ID above
# DISCORD_OAUTH_CLIENT_SECRET=""

# ── Google OAuth (customer login + admin Google login) ─────────────────────────
# Google Cloud Console (console.cloud.google.com) > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Application type: Web application.
# Add this exact Authorized redirect URI: <NEXT_PUBLIC_APP_ORIGIN>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── GitHub OAuth (customer login only) ──────────────────────────────────────────
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Authorization callback URL: <NEXT_PUBLIC_APP_ORIGIN>/api/auth/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
