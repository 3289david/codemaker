# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# Session signing secrets (generate long random strings for production)
SESSION_SECRET="change-me-user-session-secret"
ADMIN_SESSION_SECRET="change-me-admin-session-secret"

# Seed data (used by `npm run seed`)
SEED_ADMIN_ID="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="Customer123!"

# Optional: Discord webhook for new-order notifications (skipped silently if unset)
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Public origin of the deployed app (used in a couple of absolute-URL contexts)
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3014"
